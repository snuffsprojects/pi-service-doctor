[Unit]
Description=Generate the Pi Service Doctor health report
After=network.target

[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/var/www/html/intranet/pi-service-doctor
ExecStart=/usr/bin/python3 /var/www/html/intranet/pi-service-doctor/doctor.py --output /var/www/html/intranet/pi-service-doctor/status.json --quiet --always-zero
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/www/html/intranet/pi-service-doctor

